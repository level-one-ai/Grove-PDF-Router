{
  "version": 2,
  "functions": {
    "api/test-run.js":     { "maxDuration": 300 },
    "api/file-page.js":    { "maxDuration": 300 },
    "api/webhook.js":      { "maxDuration": 300 },
    "api/callback.js":     { "maxDuration": 30  },
    "api/cron.js":         { "maxDuration": 300 },
    "api/*.js":            { "maxDuration": 60  }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *"
    }
  ],
  "routes": [
    { "src": "/dashboard", "dest": "/api/dashboard" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}
