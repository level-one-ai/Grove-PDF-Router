{
  "version": 2,
  "functions": {
    "api/webhook.js":   { "maxDuration": 60 },
    "api/callback.js":  { "maxDuration": 15 },
    "api/file-page.js": { "maxDuration": 60 },
    "api/cron.js":      { "maxDuration": 60 },
    "api/test-run.js":  { "maxDuration": 60 },
    "api/*.js":         { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *"
    }
  ],
  "routes": [
    { "src": "/dashboard", "dest": "/api/dashboard" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}
